########################################
# Environment / secrets
########################################
.env
.env.*
!.env.example
.venv/

########################################
# IDE / tooling
########################################
.claude/
.claude-plugin/
.agents/
.vscode/
.git/
.gitignore
.gitmodules
.nvmrc
biome.json
tmp/

########################################
# Documentation / changelogs
########################################
changelog/
*.md
!server/src/**/*.md
!skill/SKILL.md
!skill/references/*.md

########################################
# Contracts (server only needs ABIs in server/src/abis/)
# Keep package.json for pnpm workspace lockfile validation
########################################
contracts/
!contracts/package.json

########################################
# Skill (serve SKILL.md and references via REST)
########################################
skill/scripts/
skill/config.json.example
!skill/SKILL.md
!skill/references/*.md

########################################
# Frontend — included for frontend Docker build from root context
# Exclude build artifacts (reinstalled/rebuilt in Docker)
########################################
frontend/node_modules/
frontend/.next/
frontend/out/

########################################
# Server — dev/test only
########################################
server/test/
server/src/__tests__/
server/data/
server/dist/
server/node_modules/

########################################
# Dependencies (reinstalled in Docker build)
########################################
node_modules/

########################################
# Build artifacts / caches
########################################
.next/
out/
build/
dist/
cache/
coverage/
*.tsbuildinfo

########################################
# Logs
########################################
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

########################################
# OS
########################################
.DS_Store
*.pem
