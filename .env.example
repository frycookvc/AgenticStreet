# .env.example — copy to .env and fill in real values. NEVER commit .env.
NODE_ENV=production
PORT=3001
BASE_RPC_URL=
FACTORY_ADDRESS=
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
CHAIN_ID=8453
START_BLOCK=0
ADMIN_API_KEY=
PINATA_JWT=<your Pinata JWT>
CLAIM_BASE_URL=
DB_PATH=/app/data/agentic-street.db
POLL_INTERVAL_MS=15000
WEBHOOK_RETRY_INTERVAL_MS=60000
CORS_ORIGIN=
LOG_LEVEL=info

# Adapter addresses (set after deployment)
UNISWAP_ADAPTER=
AAVE_ADAPTER=
AERODROME_ADAPTER=
MORPHO_ADAPTER=
CURVE_ADAPTER=
ANZEN_ADAPTER=
COMPOUND_ADAPTER=
MOONWELL_ADAPTER=
FLUID_ADAPTER=

# Frontend
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=<your WalletConnect project ID>
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_BASESCAN_URL=https://basescan.org/address/
